{
  "name": "@agentmeter/desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "description": "Electron: main (окно, трей, IPC) и рендерер (попап, витрина компонентов)",
  "scripts": {
    "build": "tsc --build && npm run build:preload && npm run build:web && npm run build:menubar",
    "build:menubar": "node scripts/build-menubar.js",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:web": "vite build",
    "dev": "npm run build && node scripts/launch.js --dev",
    "gallery": "npm run build && node scripts/launch.js --gallery",
    "start": "npm run build && node scripts/launch.js",
    "package": "npm run build && electron-builder --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "release": "npm run build && electron-builder --publish always",
    "test": "cd ../.. && vitest run --project desktop"
  },
  "dependencies": {
    "@agentmeter/core": "*",
    "@agentmeter/ipc": "*",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.4.3"
  }
}
